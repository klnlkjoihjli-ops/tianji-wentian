'use client'

import { useEffect, useRef, useState } from 'react'

// 场景类型
type Scene = 'A' | 'B' | 'C' | 'D' | 'E' | 'F'

interface ProgressEvent { step: number; text: string }
interface AnalysisResult { topic: string; domains: string[]; mood: string; concepts: string[]; classics: string[] }
interface ClassicsEvent { count: number; sources: string[] }
interface DoneEvent { scene: Scene; raw: string; parsed: Record<string, string> | null }

export default function HomePage() {
  const [question, setQuestion] = useState('')
  const [loading, setLoading] = useState(false)
  const [progress, setProgress] = useState('')
  const [analysis, setAnalysis] = useState<AnalysisResult | null>(null)
  const [classics, setClassics] = useState<ClassicsEvent | null>(null)
  const [result, setResult] = useState<DoneEvent | null>(null)
  const [error, setError] = useState('')
  const [sessionId] = useState(() => crypto.randomUUID())

  const ask = async () => {
    if (!question.trim() || loading) return
    setLoading(true)
    setError('')
    setResult(null)
    setAnalysis(null)
    setClassics(null)

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, sessionId }),
      })

      const reader = res.body!.getReader()
      const decoder = new TextDecoder()

      while (true) {
        const { done, value } = await reader.read()
        if (done) break

        const text = decoder.decode(value)
        const lines = text.split('\n')

        for (const line of lines) {
          if (line.startsWith('data:')) {
            try {
              const data = JSON.parse(line.slice(5))
              const eventLine = lines[lines.indexOf(line) - 1]
              const event = eventLine?.replace('event: ', '') ?? ''

              if (event === 'progress') setProgress((data as ProgressEvent).text)
              if (event === 'analysis') setAnalysis(data as AnalysisResult)
              if (event === 'classics') setClassics(data as ClassicsEvent)
              if (event === 'done') setResult(data as DoneEvent)
              if (event === 'error') setError((data as { message: string }).message)
            } catch { /* 忽略解析错误 */ }
          }
        }
      }
    } catch (e) {
      setError(e instanceof Error ? e.message : '请求失败')
    } finally {
      setLoading(false)
      setProgress('')
    }
  }

  return (
    <div style={{ minHeight: '100vh', background: '#0a0806', color: '#f5efe0', padding: '2rem', fontFamily: "'Noto Serif SC', serif" }}>
      <h1 style={{ fontFamily: "'Zhi Mang Xing', cursive", fontSize: '3rem', textAlign: 'center', color: '#c9a84c', marginBottom: '2rem' }}>
        神 枢
      </h1>

      <div style={{ maxWidth: 640, margin: '0 auto' }}>
        <textarea
          value={question}
          onChange={e => setQuestion(e.target.value)}
          onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask() } }}
          placeholder="请问天机……"
          style={{
            width: '100%', background: 'rgba(0,0,0,.6)', border: '1px solid rgba(201,168,76,.4)',
            borderRadius: 8, color: '#fff', fontSize: '1rem', padding: '1rem', minHeight: 80,
            resize: 'none', outline: 'none', fontFamily: 'inherit',
          }}
        />

        <button
          onClick={ask}
          disabled={loading}
          style={{
            width: '100%', marginTop: '0.75rem',
            background: loading ? 'rgba(201,168,76,.3)' : 'linear-gradient(135deg,#c9a84c,#e8cc7a)',
            color: '#1a1000', border: 'none', borderRadius: 6, padding: '0.75rem',
            fontSize: '1rem', fontWeight: 700, cursor: loading ? 'not-allowed' : 'pointer',
            fontFamily: 'inherit', letterSpacing: '0.1em',
          }}
        >
          {loading ? progress || '推演中…' : '问天 →'}
        </button>

        {/* 分析进度展示 */}
        {analysis && (
          <div style={{ marginTop: '1rem', padding: '0.75rem 1rem', background: 'rgba(201,168,76,.08)', border: '1px solid rgba(201,168,76,.2)', borderRadius: 6, fontSize: '0.82rem' }}>
            <div style={{ color: 'rgba(201,168,76,.8)', marginBottom: '0.4rem' }}>意图分析</div>
            <div style={{ color: 'rgba(255,255,255,.7)' }}>议题：{analysis.topic} · 状态：{analysis.mood}</div>
            {analysis.concepts.length > 0 && (
              <div style={{ color: 'rgba(255,255,255,.55)', marginTop: '0.25rem' }}>关键概念：{analysis.concepts.join('、')}</div>
            )}
          </div>
        )}

        {classics && (
          <div style={{ marginTop: '0.5rem', fontSize: '0.75rem', color: 'rgba(255,255,255,.4)' }}>
            已检索到 {classics.count} 条相关典籍 · {classics.sources.slice(0, 3).join(' · ')}
          </div>
        )}

        {/* 错误 */}
        {error && (
          <div style={{ marginTop: '1rem', padding: '0.75rem 1rem', background: 'rgba(255,80,60,.1)', border: '1px solid rgba(255,80,60,.3)', borderRadius: 6, color: '#ff7070', fontSize: '0.88rem' }}>
            {error}
          </div>
        )}

        {/* 结果 */}
        {result?.parsed && (
          <ResultView scene={result.scene} data={result.parsed} />
        )}
      </div>
    </div>
  )
}

// 结果展示组件（后续拆分为独立文件）
function ResultView({ scene, data }: { scene: Scene; data: Record<string, string> }) {
  const cardStyle = {
    background: 'rgba(0,0,0,.6)',
    border: '1px solid rgba(255,255,255,.12)',
    borderRadius: 8,
    padding: '1rem 1.25rem',
    marginBottom: '0.75rem',
  }
  const lblStyle = { fontSize: '0.62rem', letterSpacing: '0.35em', marginBottom: '0.5rem', opacity: 0.7 }
  const bodyStyle = { fontFamily: "'Ma Shan Zheng', cursive", fontSize: '0.95rem', lineHeight: 2, color: 'rgba(255,255,255,.9)' }

  const themeColor = { A: '#c9a84c', B: '#5ecf89', C: '#7baad4', D: '#a89fe8', E: '#6dcba0', F: '#d4a843' }[scene]

  const fields: [string, string][] = Object.entries(data)
    .filter(([k]) => !['xiang'].includes(k))
    .map(([k, v]) => [k, String(v)])

  const labels: Record<string, string> = {
    title: '标题', chen: '谶 曰', song: '颂 曰', jiedu: '现代解读', advice: '给你的建议',
    diagnosis: '辨证分析', classic: '经典原文', remedy: '调养建议', practice: '日常实践',
    dominant: '五行', prophecy: '典籍印证', analysis: '时势解读', verdict: '综合研判',
    guaName: '卦名', guaDesc: '卦辞解读', yao: '爻辞解读',
    yangsheng: '节气养生', shichen: '时辰建议', topic: '议题',
    source: '出处', quote: '原文', interp: '原文解读', answer: '古人的答案',
  }

  return (
    <div style={{ marginTop: '1.5rem' }}>
      {data.xiang && (
        <div style={{ textAlign: 'center', marginBottom: '1rem', color: themeColor, fontFamily: "'Ma Shan Zheng', cursive", fontSize: '1.1rem', letterSpacing: '0.2em' }}>
          {data.xiang}
        </div>
      )}
      {fields.map(([key, val]) => val && (
        <div key={key} style={{ ...cardStyle, borderColor: `${themeColor}33` }}>
          <div style={{ ...lblStyle, color: themeColor }}>{labels[key] ?? key}</div>
          <div style={bodyStyle}>
            {Array.isArray(val) ? (val as unknown as string[]).map((v, i) => <div key={i}>· {v}</div>) : val}
          </div>
        </div>
      ))}
    </div>
  )
}

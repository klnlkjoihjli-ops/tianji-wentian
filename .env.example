# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 AI（用于典籍向量 embedding）
ZHIPU_API_KEY=your-zhipu-api-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side controls
# ACCESS_TOKEN protects the preview with a shared password.
ACCESS_TOKEN=choose-a-preview-password
# Use a separate long random secret in deployed environments.
AUTH_SECRET=replace-with-at-least-32-random-characters
# Six requests per minute per client by default (configured in route.ts).
# Deploy behind a shared rate limiter such as Upstash for multi-instance production.

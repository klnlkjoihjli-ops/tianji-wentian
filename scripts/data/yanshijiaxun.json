[
  {"source":"颜氏家训","chapter":"教子·教于婴孩","content":"教妇初来，教儿婴孩。当及婴稚，识人颜色、知人喜怒，便加教诲，使为则为，使止则止。","keywords":["教子","及早","习惯养成","幼教","趁早"]},
  {"source":"颜氏家训","chapter":"教子·威严有慈","content":"父母威严而有慈，则子女畏慎而生孝矣。吾见世间，无教而有爱，每不能然。","keywords":["威严有慈","管教","宽严相济","亲子","界限"]},
  {"source":"颜氏家训","chapter":"教子·偏宠之害","content":"贤俊者自可赏爱，顽鲁者亦当矜怜，有偏宠者，虽欲以厚之，更所以祸之。","keywords":["偏宠","公平","一视同仁","祸患","教养"]},
  {"source":"颜氏家训","chapter":"兄弟·分形连气","content":"兄弟者，分形连气之人也。方其幼也，父母左提右挈，不可一日相离。","keywords":["兄弟","手足","血脉","亲情","和睦"]},
  {"source":"颜氏家训","chapter":"治家·风化自上","content":"夫风化者，自上而行于下者也，自先而施于后者也。是以父不慈则子不孝，兄不友则弟不恭，夫不义则妇不顺。","keywords":["风化自上","以身作则","上行下效","表率","家风"]},
  {"source":"颜氏家训","chapter":"治家·俭与吝","content":"俭者，省约为礼之谓也；吝者，穷急不恤之谓也。如能施而不奢，俭而不吝，可矣。","keywords":["俭与吝","节俭","慷慨","分寸","用度"]},
  {"source":"颜氏家训","chapter":"慕贤·近朱近墨","content":"是以与善人居，如入芝兰之室，久而自芳也；与恶人居，如入鲍鱼之肆，久而自臭也。","keywords":["近朱者赤","环境","择友","耳濡目染","熏陶"]},
  {"source":"颜氏家训","chapter":"勉学·开心明目","content":"夫所以读书学问，本欲开心明目，利于行耳。","keywords":["读书目的","明理","致用","学以致用","成长"]},
  {"source":"颜氏家训","chapter":"勉学·薄技在身","content":"积财千万，不如薄技在身。技之易习而可贵者，无过读书也。","keywords":["一技之长","本领","自立","胜过财富","技能"]},
  {"source":"颜氏家训","chapter":"勉学·秉烛夜行","content":"幼而学者，如日出之光；老而学者，如秉烛夜行，犹贤乎瞑目而无见者也。","keywords":["活到老学到老","终身学习","趁早","不晚","进取"]},
  {"source":"颜氏家训","chapter":"勉学·光阴可惜","content":"光阴可惜，譬诸逝水。当博览机要，以济功业。","keywords":["惜时","光阴如水","抓紧","效率","成事"]},
  {"source":"颜氏家训","chapter":"名实·忘名立名窃名","content":"上士忘名，中士立名，下士窃名。忘名者，体道合德，享鬼神之福佑。","keywords":["忘名","名实","境界","务实","虚名"]},
  {"source":"颜氏家训","chapter":"省事·知足","content":"天地鬼神之道，皆恶满盈。谦虚冲损，可以免害。","keywords":["恶满盈","谦虚","知足","免害","守损"]},
  {"source":"颜氏家训","chapter":"涉务·应世经务","content":"士君子之处世，贵能有益于物耳，不徒高谈虚论、左琴右书，以费人君禄位也。","keywords":["有益于物","务实","经世致用","实干","担当"]},
  {"source":"颜氏家训","chapter":"养生·先须虑祸","content":"夫养生者先须虑祸，全身保性，有此生然后养之，勿徒养其无生也。","keywords":["养生先虑祸","保身","安全","防患","根本"]},
  {"source":"颜氏家训","chapter":"序致·整齐门内","content":"夫圣贤之书，教人诚孝、慎言、检迹、立身、扬名，亦已备矣。吾家风教，素为整密。","keywords":["诚孝","慎言","立身","家教","家风"]}
]

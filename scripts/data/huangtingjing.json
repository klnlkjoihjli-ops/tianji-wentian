[
  {"source":"黄庭经","chapter":"上有黄庭","content":"上有黄庭下关元，后有幽阙前命门。呼吸庐间入丹田，玉池清水灌灵根。","keywords":["黄庭","丹田","呼吸","内炼","守中"]},
  {"source":"黄庭经","chapter":"灵根坚固","content":"灵根坚固老不衰，中池有士服赤朱。横下三寸神所居，中外相距重闭之。","keywords":["灵根","固本","养元","守神","内守"]},
  {"source":"黄庭经","chapter":"急守精室","content":"急守精室勿妄泄，闭而宝之可长活。仙人道士非有神，积精累气以为真。","keywords":["守精","惜精","积精累气","固守","养真"]},
  {"source":"黄庭经","chapter":"恬淡无欲","content":"作道优游身独居，扶养性命守虚无，恬淡无欲遂得渝。","keywords":["恬淡无欲","守虚无","养性命","清静","自养"]},
  {"source":"黄庭经","chapter":"清静神明","content":"物有自然事不烦，垂拱无为心自安。虚无之居在帏间，寂寞旷然口不言。","keywords":["无为","心安","虚无","寂静","自然"]}

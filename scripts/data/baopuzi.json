[
  {"source":"抱朴子","chapter":"内篇·我命在我","content":"我命在我不在天，还丹成金亿万年。","keywords":["我命在我","主动","掌握命运","自强","不认命"]},
  {"source":"抱朴子","chapter":"内篇·乐生畏死","content":"夫圆首含气，孰不乐生而畏死哉。然身不可以无终，故贵在生时立功立德。","keywords":["乐生","立功立德","珍惜","有为","生命价值"]},
  {"source":"抱朴子","chapter":"内篇·善养生","content":"善养生者，卧起有四时之早晚，兴居有至和之常制；节宣劳逸，有与夺之要；忍怒以全阴气，抑喜以养阳气。","keywords":["养生","作息有度","劳逸","节制","调和"]},
  {"source":"抱朴子","chapter":"内篇·防微杜渐","content":"是以养生之方，唾不及远，行不疾步，耳不极听，目不久视；不欲极饥而食，食不过饱；不欲极渴而饮，饮不过多。","keywords":["养生之道","适度","不极端","饮食有节","节欲"]},
  {"source":"抱朴子","chapter":"内篇·知足者常乐","content":"知足者，则能肥遁勿用，颐光山林。是以遐栖幽遁，韬鳞掩藻，遏欲视之目，遣损明之色。","keywords":["知足","退隐","收敛","淡泊","少欲"]},
  {"source":"抱朴子","chapter":"外篇·勖学","content":"夫学者，所以清澄性理，簸扬埃秽，雕锻矿璞，砻炼屯钝，启导聪明，饰染质素。","keywords":["学习","磨砺心性","启智","雕琢","成长"]},
  {"source":"抱朴子","chapter":"外篇·锐锋钝石","content":"锐锋产乎钝石，明火炽乎暗木。贵远而贱近者，常人之用情也。","keywords":["锐锋钝石","厚积","出处不限","贵远贱近","偏见"]},
  {"source":"抱朴子","chapter":"外篇·非积渐不至","content":"千仓万箱，非一耕所得；干天之木，非旬日所长。","keywords":["积渐","非一日之功","厚积薄发","积累","耐心"]},
  {"source":"抱朴子","chapter":"外篇·君子审己","content":"君子知夫贵不可以非道求，故安贫而乐道；知夫名不可以伪立，故修身以俟时。","keywords":["安贫乐道","不以非道求","修身俟时","守正","等待"]},
  {"source":"抱朴子","chapter":"外篇·寒之积","content":"冰冻三尺，非一日之寒；积土成山，非斯须之作。是以学不可以暂辍，行不可以中止。","keywords":["冰冻三尺","持之以恒","不可中辍","坚持","积累"]}
]

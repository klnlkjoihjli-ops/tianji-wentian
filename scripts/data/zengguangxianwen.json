[
  {
    "lei": "勸學",
    "text": "一年之計在於春，一日之計在於晨，一家之計在於和，一生之計在於勤。",
    "key": ["勤奮", "時機", "計畫"]
  },
  {
    "lei": "勸學",
    "text": "書中自有黃金屋，書中自有顏如玉，書中自有千鍾粟，書中車馬多如簇。",
    "key": ["讀書", "功名", "富貴"]
  },
  {
    "lei": "勸學",
    "text": "少壯不努力，老大徒傷悲。",
    "key": ["勤學", "青春", "時光"]
  },
  {
    "lei": "勸學",
    "text": "學如逆水行舟，不進則退。",
    "key": ["學習", "進取", "堅持"]
  },
  {
    "lei": "勸學",
    "text": "黑髮不知勤學早，白首方悔讀書遲。",
    "key": ["勤學", "後悔", "時光"]
  },
  {
    "lei": "勸學",
    "text": "萬般皆下品，唯有讀書高。",
    "key": ["讀書", "科舉", "功名"]
  },
  {
    "lei": "勸學",
    "text": "人不學，不知義；玉不琢，不成器。",
    "key": ["學習", "修身", "成才"]
  },
  {
    "lei": "勸學",
    "text": "讀書須用意，一字值千金。",
    "key": ["讀書", "用心", "珍貴"]
  },
  {
    "lei": "處世",
    "text": "逢人且說三分話，未可全拋一片心。",
    "key": ["處世", "謹言", "人心"]
  },
  {
    "lei": "處世",
    "text": "忍得一時之氣，免得百日之憂。",
    "key": ["忍耐", "克制", "智慧"]
  },
  {
    "lei": "處世",
    "text": "話說三遍淡如水，事過三番心自灰。",
    "key": ["言語", "人情", "處世"]
  },
  {
    "lei": "處世",
    "text": "近水樓台先得月，向陽花木易為春。",
    "key": ["機會", "地利", "近便"]
  },
  {
    "lei": "處世",
    "text": "得忍且忍，得耐且耐，不忍不耐，小事成大。",
    "key": ["忍耐", "隱忍", "處世"]
  },
  {
    "lei": "處世",
    "text": "入山不怕傷人虎，只怕人情兩面刀。",
    "key": ["人心", "險惡", "戒備"]
  },
  {
    "lei": "處世",
    "text": "寧可直中取，不向曲中求。",
    "key": ["正直", "為人", "品格"]
  },
  {
    "lei": "處世",
    "text": "當家才知柴米貴，養兒方知父母恩。",
    "key": ["生活", "感恩", "人生"]
  },
  {
    "lei": "處世",
    "text": "良言一句三冬暖，惡語傷人六月寒。",
    "key": ["言語", "善意", "傷害"]
  },
  {
    "lei": "處世",
    "text": "萬事勸人休瞞昧，舉頭三尺有神明。",
    "key": ["誠信", "因果", "戒欺"]
  },
  {
    "lei": "處世",
    "text": "但行好事，莫問前程。",
    "key": ["行善", "無私", "修德"]
  },
  {
    "lei": "交友",
    "text": "結交須勝己，似我不如無。",
    "key": ["擇友", "益友", "進步"]
  },
  {
    "lei": "交友",
    "text": "相識滿天下，知心能幾人。",
    "key": ["知己", "友情", "人情"]
  },
  {
    "lei": "交友",
    "text": "酒逢知己千杯少，話不投機半句多。",
    "key": ["知己", "友誼", "投緣"]
  },
  {
    "lei": "交友",
    "text": "在家靠父母，出門靠朋友。",
    "key": ["朋友", "依靠", "人際"]
  },
  {
    "lei": "交友",
    "text": "路遙知馬力，日久見人心。",
    "key": ["識人", "時間", "真心"]
  },
  {
    "lei": "交友",
    "text": "君子之交淡如水，小人之交甜如蜜。",
    "key": ["君子", "小人", "交情"]
  },
  {
    "lei": "交友",
    "text": "近朱者赤，近墨者黑。",
    "key": ["環境", "影響", "擇友"]
  },
  {
    "lei": "交友",
    "text": "人情似紙張張薄，世事如棋局局新。",
    "key": ["人情", "世事", "無常"]
  },
  {
    "lei": "孝親",
    "text": "百善孝為先，論心不論跡，論跡貧家無孝子。",
    "key": ["孝道", "誠心", "父母"]
  },
  {
    "lei": "孝親",
    "text": "慈母手中線，遊子身上衣，臨行密密縫，意恐遲遲歸。",
    "key": ["慈母", "親情", "牽掛"]
  },
  {
    "lei": "孝親",
    "text": "羊有跪乳之恩，鴉有反哺之義。",
    "key": ["孝親", "報恩", "感念"]
  },
  {
    "lei": "孝親",
    "text": "父母在，不遠遊，遊必有方。",
    "key": ["孝道", "父母", "侍親"]
  },
  {
    "lei": "孝親",
    "text": "樹欲靜而風不止，子欲養而親不待。",
    "key": ["孝親", "時不我待", "遺憾"]
  },
  {
    "lei": "勤儉",
    "text": "一粥一飯，當思來之不易；半絲半縷，恆念物力維艱。",
    "key": ["節儉", "珍惜", "物力"]
  },
  {
    "lei": "勤儉",
    "text": "勤是搖錢樹，儉是聚寶盆。",
    "key": ["勤勞", "節儉", "積累"]
  },
  {
    "lei": "勤儉",
    "text": "由儉入奢易，由奢入儉難。",
    "key": ["節儉", "奢侈", "習慣"]
  },
  {
    "lei": "勤儉",
    "text": "成由勤儉敗由奢，莫把無時當有時。",
    "key": ["勤儉", "興衰", "警示"]
  },
  {
    "lei": "勤儉",
    "text": "一勤天下無難事，百忍堂中有太和。",
    "key": ["勤勞", "忍耐", "和諧"]
  },
  {
    "lei": "勤儉",
    "text": "富從升合起，貧因不算來。",
    "key": ["積累", "節省", "財富"]
  },
  {
    "lei": "知人識世",
    "text": "畫虎畫皮難畫骨，知人知面不知心。",
    "key": ["識人", "人心", "難測"]
  },
  {
    "lei": "知人識世",
    "text": "聽其言，觀其行，方知人之善惡。",
    "key": ["識人", "言行", "判斷"]
  },
  {
    "lei": "知人識世",
    "text": "疾風知勁草，板蕩識誠臣。",
    "key": ["考驗", "識才", "忠誠"]
  },
  {
    "lei": "知人識世",
    "text": "有錢道真語，無錢語不真，不信但看筵中酒，杯杯先勸有錢人。",
    "key": ["世態", "貧富", "人情"]
  },
  {
    "lei": "知人識世",
    "text": "貧居鬧市無人問，富在深山有遠親。",
    "key": ["貧富", "世態炎涼", "人情"]
  },
  {
    "lei": "知人識世",
    "text": "時來風送滕王閣，運去雷轟薦福碑。",
    "key": ["時運", "機遇", "命運"]
  },
  {
    "lei": "知人識世",
    "text": "莫道君行早，更有早行人。",
    "key": ["謙遜", "競爭", "自勉"]
  },
  {
    "lei": "知人識世",
    "text": "見人善，即思齊；縱去遠，以漸躋。",
    "key": ["學習", "榜樣", "見賢思齊"]
  },
  {
    "lei": "知人識世",
    "text": "責人之心責己，恕己之心恕人。",
    "key": ["寬恕", "自省", "公平"]
  },
  {
    "lei": "天命時運",
    "text": "謀事在人，成事在天，盡人事以待天命。",
    "key": ["天命", "人事", "盡力"]
  },
  {
    "lei": "天命時運",
    "text": "命裡有時終須有，命裡無時莫強求。",
    "key": ["天命", "隨緣", "知足"]
  },
  {
    "lei": "天命時運",
    "text": "時來天地皆同力，運去英雄不自由。",
    "key": ["時運", "天時", "英雄"]
  },
  {
    "lei": "天命時運",
    "text": "善有善報，惡有惡報，不是不報，時候未到。",
    "key": ["因果", "善惡", "報應"]
  },
  {
    "lei": "天命時運",
    "text": "人算不如天算，強求終不如意。",
    "key": ["天命", "謀算", "隨緣"]
  },
  {
    "lei": "天命時運",
    "text": "富貴自是福來享，貧賤難消業未消。",
    "key": ["富貴", "業報", "命運"]
  },
  {
    "lei": "天命時運",
    "text": "積善之家，必有餘慶；積不善之家，必有餘殃。",
    "key": ["積善", "因果", "家道"]
  }
]

[
  {
    "pian": "始计篇",
    "text": "兵者，国之大事，死生之地，存亡之道，不可不察也。",
    "key": ["战争", "国家大事", "慎重", "存亡"]
  },
  {
    "pian": "始计篇",
    "text": "道者，令民与上同意也，故可以与之死，可以与之生，而不畏危。",
    "key": ["道", "领导力", "凝聚人心", "上下同欲"]
  },
  {
    "pian": "始计篇",
    "text": "天者，阴阳、寒暑、时制也。地者，远近、险易、广狭、死生也。",
    "key": ["天时", "地利", "环境分析", "形势判断"]
  },
  {
    "pian": "始计篇",
    "text": "将者，智、信、仁、勇、严也。",
    "key": ["将领", "领导力", "品质", "智慧"]
  },
  {
    "pian": "始计篇",
    "text": "法者，曲制、官道、主用也。",
    "key": ["法制", "组织管理", "制度", "军纪"]
  },
  {
    "pian": "始计篇",
    "text": "多算胜，少算不胜，而况于无算乎！吾以此观之，胜负见矣。",
    "key": ["谋算", "谋略", "胜算", "决策"]
  },
  {
    "pian": "始计篇",
    "text": "兵者，诡道也。故能而示之不能，用而示之不用，近而示之远，远而示之近。",
    "key": ["诡道", "欺骗", "谋略", "虚实"]
  },
  {
    "pian": "始计篇",
    "text": "攻其无备，出其不意。此兵家之胜，不可先传也。",
    "key": ["出奇制胜", "攻其不备", "谋略", "时机把握"]
  },
  {
    "pian": "作战篇",
    "text": "凡用兵之法，驰车千驷，革车千乘，带甲十万，千里馈粮，则内外之费，宾客之用，胶漆之材，车甲之奉，日费千金，然后十万之师举矣。",
    "key": ["战争成本", "后勤", "资源", "决策"]
  },
  {
    "pian": "作战篇",
    "text": "兵贵胜，不贵久。",
    "key": ["速胜", "效率", "时机把握", "竞争策略"]
  },
  {
    "pian": "作战篇",
    "text": "故兵闻拙速，未睹巧之久也。",
    "key": ["速战速决", "效率", "谋略", "时机把握"]
  },
  {
    "pian": "作战篇",
    "text": "故智将务食于敌，食敌一钟，当吾二十钟；忌秆一石，当吾二十石。",
    "key": ["因粮于敌", "资源利用", "竞争策略", "智慧"]
  },
  {
    "pian": "作战篇",
    "text": "车战，得车十乘已上，赏其先得者，而更其旌旗，车杂而乘之，卒善而养之，是谓胜敌而益强。",
    "key": ["战利品", "壮大实力", "竞争策略", "资源"]
  },
  {
    "pian": "作战篇",
    "text": "故知兵之将，生民之司命，国家安危之主也。",
    "key": ["将领责任", "领导力", "国家安危", "决策"]
  },
  {
    "pian": "谋攻篇",
    "text": "夫用兵之法，全国为上，破国次之；全军为上，破军次之；全旅为上，破旅次之；全卒为上，破卒次之；全伍为上，破伍次之。",
    "key": ["全胜策略", "谋略", "不战而屈人之兵", "竞争策略"]
  },
  {
    "pian": "谋攻篇",
    "text": "百战百胜，非善之善者也；不战而屈人之兵，善之善者也。",
    "key": ["不战而胜", "谋略", "全胜", "智慧"]
  },
  {
    "pian": "谋攻篇",
    "text": "上兵伐谋，其次伐交，其次伐兵，其下攻城。",
    "key": ["谋略", "外交", "竞争策略", "决策"]
  },
  {
    "pian": "谋攻篇",
    "text": "故善用兵者，屈人之兵而非战也，拔人之城而非攻也，毁人之国而非久也，必以全争于天下。",
    "key": ["全胜", "不战而屈人之兵", "谋略", "竞争策略"]
  },
  {
    "pian": "谋攻篇",
    "text": "知彼知己，百战不殆；不知彼而知己，一胜一负；不知彼，不知己，每战必殆。",
    "key": ["知己知彼", "情报", "谋略", "胜算"]
  },
  {
    "pian": "谋攻篇",
    "text": "故君之所以患于军者三：不知军之不可以进而谓之进，不知军之不可以退而谓之退，是谓縻军。",
    "key": ["领导力", "决策", "指挥", "管理"]
  },
  {
    "pian": "谋攻篇",
    "text": "故知胜有五：知可以战与不可以战者胜，识众寡之用者胜，上下同欲者胜，以虞待不虞者胜，将能而君不御者胜。",
    "key": ["胜算", "知己知彼", "领导力", "谋略"]
  },
  {
    "pian": "军形篇",
    "text": "昔之善战者，先为不可胜，以待敌之可胜。不可胜在己，可胜在敌。",
    "key": ["防守", "时机把握", "主动权", "谋略"]
  },
  {
    "pian": "军形篇",
    "text": "善守者，藏于九地之下；善攻者，动于九天之上，故能自保而全胜也。",
    "key": ["攻守", "谋略", "竞争策略", "全胜"]
  },
  {
    "pian": "军形篇",
    "text": "胜兵先胜而后求战，败兵先战而后求胜。",
    "key": ["先胜", "谋略", "决策", "胜算"]
  },
  {
    "pian": "军形篇",
    "text": "善用兵者，修道而保法，故能为胜败之政。",
    "key": ["制度", "法制", "领导力", "管理"]
  },
  {
    "pian": "军形篇",
    "text": "兵法：一曰度，二曰量，三曰数，四曰称，五曰胜。地生度，度生量，量生数，数生称，称生胜。",
    "key": ["分析", "评估", "决策", "谋略"]
  },
  {
    "pian": "军形篇",
    "text": "称胜者之战民也，若决积水于千仞之溪者，形也。",
    "key": ["势", "力量积累", "竞争策略", "形势"]
  },
  {
    "pian": "兵势篇",
    "text": "凡治众如治寡，分数是也；斗众如斗寡，形名是也。",
    "key": ["组织管理", "领导力", "制度", "指挥"]
  },
  {
    "pian": "兵势篇",
    "text": "三军之众，可使必受敌而无败者，奇正是也。",
    "key": ["奇正", "谋略", "竞争策略", "战术"]
  },
  {
    "pian": "兵势篇",
    "text": "战势不过奇正，奇正之变，不可胜穷也。奇正相生，如循环之无端，孰能穷之哉！",
    "key": ["奇正变化", "灵活应变", "谋略", "创新"]
  },
  {
    "pian": "兵势篇",
    "text": "激水之疾，至于漂石者，势也；鸷鸟之疾，至于毁折者，节也。",
    "key": ["势", "节奏", "时机把握", "力量"]
  },
  {
    "pian": "兵势篇",
    "text": "善战者，求之于势，不责于人，故能择人而任势。",
    "key": ["势", "用人", "领导力", "谋略"]
  },
  {
    "pian": "兵势篇",
    "text": "故善战人之势，如转圆石于千仞之山者，势也。",
    "key": ["势", "力量积累", "竞争策略", "时机把握"]
  },
  {
    "pian": "虚实篇",
    "text": "凡先处战地而待敌者佚，后处战地而趋战者劳。故善战者，致人而不致于人。",
    "key": ["主动权", "先机", "谋略", "竞争策略"]
  },
  {
    "pian": "虚实篇",
    "text": "进而不可御者，冲其虚也；退而不可追者，速而不可及也。",
    "key": ["虚实", "谋略", "竞争策略", "灵活应变"]
  },
  {
    "pian": "虚实篇",
    "text": "故我欲战，敌虽高垒深沟，不得不与我战者，攻其所必救也。",
    "key": ["牵制", "谋略", "主动权", "竞争策略"]
  },
  {
    "pian": "虚实篇",
    "text": "形人而我无形，则我专而敌分。",
    "key": ["虚实", "信息不对称", "谋略", "竞争策略"]
  },
  {
    "pian": "虚实篇",
    "text": "兵之形，避实而击虚。",
    "key": ["虚实", "谋略", "竞争策略", "战术"]
  },
  {
    "pian": "虚实篇",
    "text": "兵无常势，水无常形；能因敌变化而取胜者，谓之神。",
    "key": ["灵活应变", "变化", "谋略", "智慧"]
  },
  {
    "pian": "虚实篇",
    "text": "故五行无常胜，四时无常位，日有短长，月有死生。",
    "key": ["变化", "灵活应变", "规律", "时机把握"]
  },
  {
    "pian": "军争篇",
    "text": "军争之难者，以迂为直，以患为利。",
    "key": ["谋略", "化劣为优", "竞争策略", "智慧"]
  },
  {
    "pian": "军争篇",
    "text": "故迂其途，而诱之以利，后人发，先人至，此知迂直之计者也。",
    "key": ["迂直", "谋略", "竞争策略", "时机把握"]
  },
  {
    "pian": "军争篇",
    "text": "故三军可夺气，将军可夺心。是故朝气锐，昼气惰，暮气归。善用兵者，避其锐气，击其惰归，此治气者也。",
    "key": ["士气", "时机把握", "谋略", "领导力"]
  },
  {
    "pian": "军争篇",
    "text": "以治待乱，以静待哗，此治心者也。",
    "key": ["稳定", "谋略", "领导力", "应变"]
  },
  {
    "pian": "军争篇",
    "text": "故用兵之法，高陵勿向，背丘勿逆，佯北勿从，锐卒勿攻，饵兵勿食，归师勿遏，围师必阙，穷寇勿迫，此用兵之法也。",
    "key": ["战术原则", "谋略", "竞争策略", "决策"]
  },
  {
    "pian": "军争篇",
    "text": "故兵以诈立，以利动，以分合为变者也。",
    "key": ["谋略", "利益驱动", "灵活应变", "竞争策略"]
  },
  {
    "pian": "九变篇",
    "text": "将通于九变之利者，知用兵矣；将不通九变之利，虽知地形，不能得地之利矣。",
    "key": ["灵活应变", "谋略", "领导力", "智慧"]
  },
  {
    "pian": "九变篇",
    "text": "故用兵之法，无恃其不来，恃吾有以待也；无恃其不攻，恃吾有所不可攻也。",
    "key": ["防守", "主动准备", "谋略", "竞争策略"]
  },
  {
    "pian": "九变篇",
    "text": "故将有五危：必死，可杀也；必生，可虏也；忿速，可侮也；廉洁，可辱也；爱民，可烦也。",
    "key": ["领导力", "弱点", "决策", "将领品质"]
  },
  {
    "pian": "九变篇",
    "text": "智者之虑，必杂于利害。杂于利，而务可信也；杂于害，而患可解也。",
    "key": ["利害权衡", "谋略", "决策", "智慧"]
  },
  {
    "pian": "九变篇",
    "text": "是故屈诸侯者以害，役诸侯者以业，趋诸侯者以利。",
    "key": ["利益", "谋略", "竞争策略", "决策"]
  },
  {
    "pian": "行军篇",
    "text": "凡处军相敌：绝山依谷，视生处高，战隆无登，此处山之军也。",
    "key": ["地形利用", "形势判断", "战术", "环境分析"]
  },
  {
    "pian": "行军篇",
    "text": "兵非贵益多也，惟无武进，足以并力、料敌、取人而已。",
    "key": ["精兵", "谋略", "决策", "竞争策略"]
  },
  {
    "pian": "行军篇",
    "text": "令之以文，齐之以武，是谓必取。令素行以教其民，则民服；令不素行以教其民，则民不服。",
    "key": ["管理", "领导力", "制度", "执行力"]
  },
  {
    "pian": "行军篇",
    "text": "卒未亲附而罚之，则不服，不服则难用也。卒已亲附而罚不行，则不可用也。",
    "key": ["管理", "领导力", "恩威并施", "执行力"]
  },
  {
    "pian": "行军篇",
    "text": "故令之以文，齐之以武，是谓必取。",
    "key": ["文武并用", "领导力", "管理", "执行力"]
  },
  {
    "pian": "行军篇",
    "text": "相敌之法：众树动者，来也；众草多障者，疑也；鸟起者，伏也；兽骇者，覆也。",
    "key": ["情报", "观察", "知己知彼", "判断"]
  },
  {
    "pian": "地形篇",
    "text": "地形者，兵之助也。料敌制胜，计险厄远近，上将之道也。知此而用战者必胜，不知此而用战者必败。",
    "key": ["地形", "知己知彼", "谋略", "决策"]
  },
  {
    "pian": "地形篇",
    "text": "知彼知己，胜乃不殆；知天知地，胜乃可全。",
    "key": ["知己知彼", "环境分析", "胜算", "谋略"]
  },
  {
    "pian": "地形篇",
    "text": "视卒如婴儿，故可与之赴深溪；视卒如爱子，故可与之俱死。",
    "key": ["领导力", "爱护下属", "凝聚力", "管理"]
  },
  {
    "pian": "地形篇",
    "text": "故战道必胜，主曰无战，必战可也；战道不胜，主曰必战，无战可也。",
    "key": ["决策", "主动权", "领导力", "谋略"]
  },
  {
    "pian": "地形篇",
    "text": "进不求名，退不避罪，唯人是保，而利合于主，国之宝也。",
    "key": ["领导力", "忠诚", "责任", "将领品质"]
  },
  {
    "pian": "地形篇",
    "text": "夫地形者，兵之助也。故有通者，有挂者，有支者，有隘者，有险者，有远者。",
    "key": ["地形分析", "环境分析", "战术", "形势判断"]
  },
  {
    "pian": "九地篇",
    "text": "用兵之法，有散地，有轻地，有争地，有交地，有衢地，有重地，有圮地，有围地，有死地。",
    "key": ["地形分类", "战略", "谋略", "形势判断"]
  },
  {
    "pian": "九地篇",
    "text": "投之亡地然后存，陷之死地然后生。夫众陷于害，然后能为胜败。",
    "key": ["置之死地而后生", "逆境", "激励", "谋略"]
  },
  {
    "pian": "九地篇",
    "text": "善用兵者，譬如率然；率然者，常山之蛇也。击其首则尾至，击其尾则首至，击其中则首尾俱至。",
    "key": ["协同", "整体配合", "领导力", "组织管理"]
  },
  {
    "pian": "九地篇",
    "text": "是故始如处女，敌人开户，后如脱兔，敌不及拒。",
    "key": ["时机把握", "谋略", "出奇制胜", "竞争策略"]
  },
  {
    "pian": "九地篇",
    "text": "将军之事：静以幽，正以治。能愚士卒之耳目，使之无知；易其事，革其谋，使人无识；易其居，迂其途，使人不得虑。",
    "key": ["保密", "领导力", "谋略", "信息管控"]
  },
  {
    "pian": "九地篇",
    "text": "并敌一向，千里杀将，此谓巧能成事者也。",
    "key": ["集中力量", "谋略", "竞争策略", "决策"]
  },
  {
    "pian": "九地篇",
    "text": "是故散地则无战，轻地则无止，争地则无攻，交地则无绝，衢地则合交，重地则掠，圮地则行，围地则谋，死地则战。",
    "key": ["因地制宜", "灵活应变", "谋略", "决策"]
  },
  {
    "pian": "火攻篇",
    "text": "凡火攻有五：一曰火人，二曰火积，三曰火辎，四曰火库，五曰火队。",
    "key": ["火攻", "战术", "谋略", "竞争策略"]
  },
  {
    "pian": "火攻篇",
    "text": "行火必有因，烟火必素具。发火有时，起火有日。",
    "key": ["时机把握", "准备", "谋略", "决策"]
  },
  {
    "pian": "火攻篇",
    "text": "以火佐攻者明，以水佐攻者强。水可以绝，不可以夺。",
    "key": ["战术", "谋略", "竞争策略", "资源利用"]
  },
  {
    "pian": "火攻篇",
    "text": "夫战胜攻取，而不修其功者凶，命之曰费留。",
    "key": ["战略眼光", "巩固成果", "决策", "领导力"]
  },
  {
    "pian": "火攻篇",
    "text": "故明主虑之，良将修之，非利不动，非得不用，非危不战。",
    "key": ["慎战", "决策", "领导力", "利益权衡"]
  },
  {
    "pian": "火攻篇",
    "text": "主不可以怒而兴师，将不可以愠而致战；合于利而动，不合于利而止。",
    "key": ["理性决策", "慎战", "领导力", "情绪管理"]
  },
  {
    "pian": "火攻篇",
    "text": "怒可以复喜，愠可以复悦，亡国不可以复存，死者不可以复生。",
    "key": ["慎重", "决策", "领导力", "战略眼光"]
  },
  {
    "pian": "用间篇",
    "text": "故明君贤将，所以动而胜人，成功出于众者，先知也。",
    "key": ["情报", "知己知彼", "先知", "谋略"]
  },
  {
    "pian": "用间篇",
    "text": "先知者，不可取于鬼神，不可象于事，不可验于度，必取于人，知敌之情者也。",
    "key": ["情报", "知己知彼", "实际调查", "谋略"]
  },
  {
    "pian": "用间篇",
    "text": "故用间有五：有因间，有内间，有反间，有死间，有生间。五间俱起，莫知其道，是谓神纪，人君之宝也。",
    "key": ["间谍", "情报", "谋略", "知己知彼"]
  },
  {
    "pian": "用间篇",
    "text": "故三军之事，莫亲于间，赏莫厚于间，事莫密于间。",
    "key": ["情报", "间谍", "保密", "谋略"]
  },
  {
    "pian": "用间篇",
    "text": "反间者，因其敌间而用之。死间者，为诳事于外，令吾间知之，而传于敌间也。",
    "key": ["反间计", "情报", "谋略", "竞争策略"]
  },
  {
    "pian": "用间篇",
    "text": "故惟明君贤将，能以上智为间者，必成大功。此兵之要，三军之所恃而动也。",
    "key": ["情报", "智慧", "领导力", "谋略"]
  }
]

[
  {
    "zhang": "原始章第一",
    "text": "道者，人之所蹈，使萬物不知其所由。德者，人之所得，使萬物各得其所欲。",
    "key": ["道德", "萬物", "自然", "本源"]
  },
  {
    "zhang": "原始章第一",
    "text": "仁者，人之所親，有慈惠惻隱之心，以遂其生成。義者，人之所宜，賞善罰惡，以立功立事。",
    "key": ["仁義", "慈惠", "賞善罰惡", "處世"]
  },
  {
    "zhang": "原始章第一",
    "text": "禮者，人之所履，夙興夜寐，以成人倫之序。",
    "key": ["禮", "人倫", "秩序", "道德"]
  },
  {
    "zhang": "原始章第一",
    "text": "夫道、德、仁、義、禮，五者一體也。道者，萬善之源。德者，萬善之根。",
    "key": ["道德", "仁義", "禮", "根本"]
  },
  {
    "zhang": "原始章第一",
    "text": "賢人君子，明於盛衰之道，通乎成敗之數，審乎治亂之勢，達乎去就之理。",
    "key": ["識人", "盛衰", "治亂", "智慧"]
  },
  {
    "zhang": "原始章第一",
    "text": "故潛居抱道，以待其時。若時至而行，則能極人臣之位。",
    "key": ["謀略", "待時", "進退", "處世"]
  },
  {
    "zhang": "原始章第一",
    "text": "得機而動，則能成絕代之功。如其不遇，沒身而已。",
    "key": ["謀略", "時機", "勝敗", "進退"]
  },
  {
    "zhang": "正道章第二",
    "text": "德足以懷遠，信足以一異，義足以得衆，才足以鑒古，明足以照下，此人之俊也。",
    "key": ["識人", "德才", "用人", "智慧"]
  },
  {
    "zhang": "正道章第二",
    "text": "行足以為儀表，智足以決嫌疑，信可以使守約，廉可以使分財，此人之豪也。",
    "key": ["識人", "德才", "品行", "智慧"]
  },
  {
    "zhang": "正道章第二",
    "text": "守職而不廢，處義而不回，見嫌而不苟免，見利而不苟得，此人之傑也。",
    "key": ["品行", "義", "處世", "道德"]
  },
  {
    "zhang": "正道章第二",
    "text": "德不稱，其禍必酷。能不稱，其殃必大。德薄而位尊，知小而謀大，力小而任重，鮮不及矣。",
    "key": ["德才", "安危", "勝敗", "處世"]
  },
  {
    "zhang": "正道章第二",
    "text": "聖人君子，知所去就，進退有常，不以貧賤而改心，不以富貴而易志。",
    "key": ["進退", "品行", "志氣", "處世"]
  },
  {
    "zhang": "正道章第二",
    "text": "有道則仕，無道則隱。不以己之得喪，累於天下之憂樂。",
    "key": ["進退", "道德", "處世", "智慧"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "絕嗜禁欲，所以除累。抑非損惡，所以讓過。貶酒闕色，所以無污。",
    "key": ["修身", "道德", "自律", "處世"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "避嫌遠疑，所以不誤。博學切問，所以廣知。高行微言，所以修身。",
    "key": ["修身", "智慧", "謹慎", "學問"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "恭儉謙約，所以自守。深計遠慮，所以不窮。疏知筋骨，所以壽身。",
    "key": ["謹慎", "謀略", "修身", "自守"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "夫志，心獨行之術。長莫長於博謀，安莫安於忍辱，先莫先於修德。",
    "key": ["謀略", "修身", "忍辱", "智慧"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "樂莫樂於好善，神莫神於至誠，明莫明於自知，病莫病於無常。",
    "key": ["修身", "至誠", "自知", "智慧"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "短莫短於苟得，幽莫幽於貪鄙，孤莫孤於自恃，危莫危於任疑。",
    "key": ["安危", "品行", "謹慎", "處世"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "敗莫敗於多私，費莫費於多欲，禍莫禍於不知足。",
    "key": ["勝敗", "修身", "知足", "道德"]
  },
  {
    "zhang": "求人之志章第三",
    "text": "以明示下者暗，有過不知者蔽，迷而不返者惑，以言取怨者禍。",
    "key": ["智慧", "自知", "謹慎", "安危"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "務善策者，無惡事。無遠慮者，有近憂。同志相得，同仁相憂，同惡相黨，同愛相求。",
    "key": ["謀略", "識人", "用人", "智慧"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "救寒莫如重裘，止謗莫如自修。聞譽恐，聞過欣，所以進德。",
    "key": ["修身", "道德", "進退", "處世"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "厚者不毀人以自益，仁者不危人以自安，智者不詐人以成謀。",
    "key": ["仁義", "品行", "道德", "處世"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "受人恩惠，則念之。見人善行，則思之。見人惡行，則戒之。",
    "key": ["修身", "品行", "道德", "處世"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "陰計外泄者，敗。厚貌深情者，狡。慷慨輕財者，義。緩於取，急於施者，富。",
    "key": ["識人", "謀略", "品行", "智慧"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "愛之欲其生，惡之欲其死，愛惡之謹者，如親仇者失之。",
    "key": ["識人", "用人", "謹慎", "智慧"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "設變致權，所以解結。括囊順會，所以無咎。橛橛梗梗，所以立功。",
    "key": ["謀略", "應變", "立功", "處世"]
  },
  {
    "zhang": "本德宗道章第四",
    "text": "孫而不費，廉而不刿，直而不挺，忠而不倦，此四者，德之輔也。",
    "key": ["道德", "品行", "修身", "處世"]
  },
  {
    "zhang": "遵義章第五",
    "text": "以明示下者暗。有過不知者蔽。迷而不返者惑。以言取怨者禍。令與心乖者廢。",
    "key": ["治國", "智慧", "安危", "謹慎"]
  },
  {
    "zhang": "遵義章第五",
    "text": "賞罰不明，眾善不進。進賢不用，任事不恤，有功不賞，無過不赦，此亡國之道。",
    "key": ["治國", "用人", "賞罰", "安危"]
  },
  {
    "zhang": "遵義章第五",
    "text": "親疏若一，所以見情。愛而知惡，憎而知善，知罰知賞，此明君之道。",
    "key": ["治國", "識人", "賞罰", "智慧"]
  },
  {
    "zhang": "遵義章第五",
    "text": "人主不仁，則臣不盡力。主不明，則臣多奸。主下比周，則正臣危。",
    "key": ["治國", "君臣", "安危", "道德"]
  },
  {
    "zhang": "遵義章第五",
    "text": "明君之道，務知人心，以己度人，察言觀行，知人勝己者，勝己也。",
    "key": ["治國", "識人", "智慧", "用人"]
  },
  {
    "zhang": "遵義章第五",
    "text": "能知彼知己，勝可保也。知地知天，勝乃不窮。不戰而知勝敗，此百戰百勝之道。",
    "key": ["謀略", "勝敗", "知己知彼", "智慧"]
  },
  {
    "zhang": "遵義章第五",
    "text": "治國之道，在乎擇人。用人之道，在乎知人。知人之道，在乎明察。",
    "key": ["治國", "用人", "識人", "謀略"]
  },
  {
    "zhang": "安禮章第六",
    "text": "怨在不捨小過，患在不預定謀。福在積善，禍在積惡。",
    "key": ["安危", "謀略", "積善", "道德"]
  },
  {
    "zhang": "安禮章第六",
    "text": "飢在賤農，寒在墮織，安在得人，危在失士。富在迎來，貧在棄時。",
    "key": ["安危", "用人", "治國", "謀略"]
  },
  {
    "zhang": "安禮章第六",
    "text": "上無常操，下多疑心。輕上生罪，侮下生怨。近臣不重，遠臣輕之。",
    "key": ["治國", "君臣", "安危", "謹慎"]
  },
  {
    "zhang": "安禮章第六",
    "text": "自知者英，知人者雄。自勝者強，勝人者力。自愛者仁，愛人者義。",
    "key": ["自知", "識人", "修身", "智慧"]
  },
  {
    "zhang": "安禮章第六",
    "text": "強在勝己，貴在下人。危在任小人，辱在去善遠賢。",
    "key": ["安危", "用人", "識人", "處世"]
  },
  {
    "zhang": "安禮章第六",
    "text": "屈人以利，不屈以力。來而不拒，去而不追。非義而授，非義而奪，亦不處也。",
    "key": ["謀略", "進退", "義", "處世"]
  },
  {
    "zhang": "安禮章第六",
    "text": "見善而急，見惡而緩，好謀而成，能讓以義，能讓以利，此人可長守也。",
    "key": ["識人", "品行", "謀略", "用人"]
  }
]
